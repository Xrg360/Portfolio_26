# Copy to .env.local for local dev; set the same vars in Vercel → Project → Settings → Environment Variables.

# Canonical origin (optional)
# NEXT_PUBLIC_SITE_URL=https://rohit.simplewebsite.in

# Live typing stat in the Skills section. Generate an ApeKey on monkeytype.com
# (Account settings → Ape keys), activate it, and paste it here. Server-side only:
# it never reaches the browser. Leave unset to hide the widget.
# MONKEYTYPE_APE_KEY=

# Phase-2 chat (not built yet)
# NEXT_PUBLIC_ENABLE_ASK_CHAT=true
